build/
# The Qt 5 and the first Qt 6 trees, from before there was a single build/.
build-modern/
build-qt6/
# release artifacts: tools/mkdeb.sh writes the .deb here
dist/
# autotools generates these inside cjson's tree
components/cjson/configure
components/cjson/Makefile.in
components/cjson/aclocal.m4
components/cjson/autom4te.cache/
components/cjson/config.h.in
components/cjson/compile
components/cjson/config.guess
components/cjson/config.sub
components/cjson/depcomp
components/cjson/install-sh
components/cjson/ltmain.sh
components/cjson/missing
components/cjson/m4/
# qmake builds inside the source tree (as HP did): keep its artifacts out of git
components/*/debug-x86/
components/*/Makefile.Ubuntu
components/*/.qmake.stash

# logs the qmake build and service scripts leave next to the sources
components/*/qmake.log
components/*/build.log
components/*/install.log
components/*/cfg.log

# Python bytecode, from the tools under tools/
__pycache__/
*.pyc

# editor settings, not the project's
.vscode/

# npm ci installs the pinned tooling from package-lock.json
node_modules/
