# tools/node-home.sh.
#
# The hash is pinned here rather than fetched alongside the tarball, so a
# compromised mirror cannot hand over both a tampered file and a matching
# SHASUMS256.txt. It was taken from SHASUMS256.txt after checking that file's
# signature against nodejs/release-keys:
#
#   gpg: Good signature from "Antoine du Hamel <antoine.duhamel@platformatic.dev>"
#   using EDDSA key 5BE8A3F6C8A5C01D106C0AD820B1A390B168D356
#
# To move to another release: take the new line from its SHASUMS256.txt, verify
# that file's signature the same way, and change both values together.
#
# 24 is the active LTS ("Krypton"). 26 becomes LTS in October 2026. The addons
# are pure N-API -- measured, no v8:: or node:: symbols -- so changing this does
# not mean rebuilding them for a new ABI.
NODE_VERSION=v24.21.0
